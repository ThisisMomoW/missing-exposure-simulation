Sys.setenv(RENV_PATHS_LIBRARY=file.path(getwd(),"renv/library"),
           RENV_PATHS_CACHE=file.path(getwd(),"renv/cache"),
           RENV_PATHS_ROOT=file.path(getwd(),"renv/local"),
           RENV_CONFIG_SANDBOX_ENABLED="FALSE",RENV_CONFIG_AUTO_SNAPSHOT="FALSE")
